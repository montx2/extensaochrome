{
  "manifest_version": 3,
  "name": "ISS.net Itaúna - Assistente de Optante",
  "version": "2.0.0",
  "description": "Preenche em lote o campo Simples Nacional/MEI (Não Optante, Optante SN ou Optante MEI) na Declaração de Serviços Contratados.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.issnetonline.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
