{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.0.0",
  "default_locale": "pt_BR",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/montx2/extensaochrome",
  "author": "montx2",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://*.issnetonline.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.issnetonline.com.br/*"],
      "js": ["shared/protocol.js", "content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.issnetonline.com.br/*"],
      "js": ["shared/protocol.js", "content/core.js", "content/executor.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
